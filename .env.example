# Базовый URL сайта (OG, канонический JSON-LD).
# NEXT_PUBLIC_SITE_URL=https://example.com

# Канонический host без порта (prod middleware: 301 между www и apex), напр. example.com без www.
# CANONICAL_SITE_HOST=example.com

# Юридический контакт на страницах /privacy, /cookies, /offer.
# Если не задано, используется business@trustabovefame.ru (см. src/content/legal.ts).
# NEXT_PUBLIC_LEGAL_EMAIL=business@trustabovefame.ru

# Почтовый адрес оператора для политики конфиденциальности (опционально).
# NEXT_PUBLIC_OPERATOR_ADDRESS=

# Публичный CSV из Google Таблиц (афиша). Если не задано — используется URL по умолчанию в `src/lib/get-site-shows.ts`.
# Переопределите здесь или на хостинге, если нужна другая таблица.
# CONCERTS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/1-J2ich8fjJeWoWNgREbfWJRV2ZjwwgvTUqcwfFO6ZaU/export?format=csv&gid=0
